# ---- Backend (apps/api) ----
# Comma-separated list of origins allowed to call the API (CORS).
AGENTFLOW_CORS_ORIGINS=http://localhost:3000
# Optional: override the "as-of" decision timestamp used by the dashboard snapshot (ISO 8601).
AGENTFLOW_AS_OF=

# ---- Frontend (apps/web) ----
# Base URL of the AgentFlow API as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
