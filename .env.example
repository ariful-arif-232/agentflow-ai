# ---- Backend (apps/api) ----
# Comma-separated list of origins allowed to call the API (CORS).
AGENTFLOW_CORS_ORIGINS=http://localhost:3000
# Optional: override the "as-of" decision timestamp used by the dashboard snapshot (ISO 8601).
AGENTFLOW_AS_OF=
# Optional: Phase-2 logistics-cost proxy overrides (numbers only). Defaults are synthetic demo
# assumptions, not upay or distributor rates; replace them with governed operator rates.
# AGENTFLOW_LOGISTICS_BASE_HANDLING_BDT=100
# AGENTFLOW_LOGISTICS_DISTANCE_MULTIPLIER=2
# AGENTFLOW_LOGISTICS_PER_KM_OPERATING_COST_BDT=12
# AGENTFLOW_LOGISTICS_AVERAGE_FIELD_SPEED_KMH=15
# AGENTFLOW_LOGISTICS_HANDLING_TIME_MINUTES=15
# AGENTFLOW_LOGISTICS_FIELD_OFFICER_COST_PER_HOUR_BDT=250
# AGENTFLOW_LOGISTICS_CASH_IN_TRANSIT_BPS=10
# AGENTFLOW_LOGISTICS_DISTRIBUTOR_BASE_HANDLING_BDT=150
# AGENTFLOW_LOGISTICS_DISTRIBUTOR_DISTANCE_MULTIPLIER=2
# Optional: Phase-2 business-impact rates (numbers only). Illustrative assumptions, not upay's or any
# provider's rates. Without a distributor fee only the break-even fee per trip is reported.
# AGENTFLOW_BUSINESS_AGENT_COMMISSION_BPS=50
# AGENTFLOW_BUSINESS_DISTRIBUTOR_FEE_PER_TRIP_BDT=

# ---- Frontend (apps/web) ----
# Base URL of the AgentFlow API as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
